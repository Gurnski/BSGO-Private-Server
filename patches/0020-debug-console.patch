+                label, guid, shipCard.getFaction(), shipCard.getTier(),
+                spawnPos.getX(), spawnPos.getY(), spawnPos.getZ(),
+                armed ? "" : " - UNARMED: no ShipConfigTemplate for this hull"));
+    }
