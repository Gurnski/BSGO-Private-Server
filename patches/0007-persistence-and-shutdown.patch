+     *       into Starter lets the faction handler re-roll its hangar.</li>
+     * </ul>
+     * So everything resumes docked, which is what the retail server did after a restart.
+     */
+    private static GameLocation resumableLocation(final GameLocation persistedCurrent,
+                                                  final GameLocation persistedPrevious,
+                                                  final long userId)
+    {
+        final GameLocation candidate =
+                (persistedCurrent == null || persistedCurrent == GameLocation.Disconnect)
+                        ? persistedPrevious
+                        : persistedCurrent;
+
+        if (candidate == GameLocation.Room)
+            return GameLocation.Room;
+
+        log.info("userID={} persisted location current={} previous={} is not resumable, docking instead",
+                userId, persistedCurrent, persistedPrevious);
+        return GameLocation.Room;
+    }
